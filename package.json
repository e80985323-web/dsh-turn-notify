{
  "name": "dsh-turn-notify",
  "version": "0.2.0",
  "description": "DSH Desktop 右下角通知：agent 每轮回复结束后，窗口内弹右下角卡片；窗口失焦/最小化时改弹 Windows 系统通知；点击通知可跳回 DSH Desktop",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "toast"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/notify.js",
    "lib/toast.ps1",
    "lib/focus.ps1",
    "scripts/ps1-guard.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "guard": "node scripts/ps1-guard.mjs",
    "test": "node scripts/ps1-guard.mjs && node scripts/ps1-guard.mjs --selftest"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e80985323-web/dsh-turn-notify.git"
  },
  "homepage": "https://github.com/e80985323-web/dsh-turn-notify#readme",
  "bugs": {
    "url": "https://github.com/e80985323-web/dsh-turn-notify/issues"
  },
  "license": "MIT"
}
